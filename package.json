{
  "name": "kitune",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun run build && bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "build": "bun scripts/build.ts",
    "site:dev": "bun scripts/preview-site.ts",
    "site:build": "bun scripts/build-site.ts",
    "site:preview": "bun run site:build && bun scripts/preview-site.ts --production",
    "check": "tsc --noEmit",
    "test": "bun test tests",
    "cli": "bun src/cli.ts",
    "test:dex": "bun tests/dex.integration.ts",
    "test:ui": "bun tests/ui.integration.ts",
    "test:production": "bun run build && bun tests/production.integration.ts",
    "test:docker": "bun tests/docker.integration.ts",
    "test:fly": "bun tests/fly.integration.ts"
  },
  "dependencies": {
    "@better-auth/core": "1.7.4",
    "@better-auth/oauth-provider": "1.7.4",
    "@better-auth/passkey": "1.7.4",
    "@simplewebauthn/browser": "13.3.0",
    "better-auth": "1.7.4",
    "hono": "4.13.7",
    "jose": "6.2.12",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
